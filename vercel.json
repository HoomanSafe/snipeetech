{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/papi/:addr",
      "destination": "/api/papi?addr=:addr"
    },
    {
      "source": "/psearch",
      "destination": "/api/psearch"
    },
    {
      "source": "/((?!api/|assets/).*)",
      "destination": "/index.html"
    }
  ]
}
